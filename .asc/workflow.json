{
  "env": {
    "VERSION": "",
    "CHANNEL": "beta",
    "BUILD_NUMBER": "",
    "NOTES_FILE": ""
  },
  "before_all": "echo \"Starting Easydict $VERSION ($CHANNEL) workflow\"",
  "after_all": "echo \"Easydict $VERSION workflow completed\"",
  "error": "echo \"Release failed. Resume with the run ID printed by asc.\"",
  "workflows": {
    "prepare": {
      "description": "Prepare and verify local release artifacts",
      "steps": [
        {
          "workflow": "prepare_steps"
        }
      ]
    },
    "draft": {
      "description": "Prepare a release and create a GitHub draft",
      "steps": [
        {
          "workflow": "prepare_steps"
        },
        {
          "workflow": "draft_steps"
        }
      ]
    },
    "publish": {
      "description": "Publish an existing draft and update the appcast",
      "steps": [
        {
          "workflow": "publish_steps"
        }
      ]
    },
    "release": {
      "description": "Run the complete Easydict release workflow",
      "steps": [
        {
          "workflow": "prepare_steps"
        },
        {
          "workflow": "draft_steps"
        },
        {
          "workflow": "publish_steps"
        }
      ]
    },
    "prepare_steps": {
      "private": true,
      "description": "Synchronize branches and prepare local artifacts",
      "steps": [
        {
          "name": "preflight_environment",
          "run": "./release-scripts/release-preflight.sh environment"
        },
        {
          "name": "prepare_release_worktree",
          "run": "./release-scripts/release-branch-sync.sh prepare"
        },
        {
          "name": "preflight_release",
          "run": "./release-scripts/release-preflight.sh release"
        },
        {
          "name": "update_version",
          "run": "./release-scripts/release-build.sh version"
        },
        {
          "name": "archive_application",
          "run": "./release-scripts/release-build.sh archive"
        },
        {
          "name": "export_application",
          "run": "./release-scripts/release-build.sh export"
        },
        {
          "name": "notarize_application",
          "run": "./release-scripts/release-package.sh notarize-app"
        },
        {
          "name": "create_sparkle_zip",
          "run": "./release-scripts/release-package.sh zip"
        },
        {
          "name": "create_notarized_dmg",
          "run": "./release-scripts/release-package.sh dmg"
        },
        {
          "name": "generate_appcast_candidate",
          "run": "./release-scripts/release-appcast.sh generate"
        },
        {
          "name": "verify_local_release",
          "run": "./release-scripts/release-verify.sh local"
        }
      ]
    },
    "draft_steps": {
      "private": true,
      "description": "Synchronize version refs and create a GitHub draft",
      "steps": [
        {
          "name": "push_version_refs",
          "run": "./release-scripts/release-branch-sync.sh push-version"
        },
        {
          "name": "create_github_draft",
          "run": "./release-scripts/release-github.sh draft"
        },
        {
          "name": "verify_github_draft",
          "run": "./release-scripts/release-github.sh verify-draft"
        }
      ]
    },
    "publish_steps": {
      "private": true,
      "description": "Publish the GitHub release and update both feeds",
      "steps": [
        {
          "name": "preflight_publish",
          "run": "./release-scripts/release-preflight.sh publish"
        },
        {
          "name": "publish_github_release",
          "run": "./release-scripts/release-github.sh publish"
        },
        {
          "name": "verify_github_release",
          "run": "./release-scripts/release-github.sh verify-published"
        },
        {
          "name": "install_appcast",
          "run": "./release-scripts/release-appcast.sh install"
        },
        {
          "name": "push_appcast_refs",
          "run": "./release-scripts/release-branch-sync.sh push-appcast"
        },
        {
          "name": "verify_remote_release",
          "run": "./release-scripts/release-verify.sh remote"
        },
        {
          "name": "cleanup_release_worktree",
          "run": "./release-scripts/release-branch-sync.sh cleanup"
        }
      ]
    }
  }
}
