    "service.codex_cli.risk_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses your local official Codex CLI. Availability may change in the future and may carry account or policy risk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tu CLI oficial local de Codex. La disponibilidad puede cambiar en el futuro y puede implicar riesgos para la cuenta o las políticas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルの公式 Codex CLI を使用します。今後利用できなくなる可能性があり、アカウントやポリシー上のリスクを伴う場合があります。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používa tvoje lokálne oficiálne Codex CLI. Dostupnosť sa môže v budúcnosti zmeniť a môže niesť riziko pre účet alebo pravidlá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务使用你本机的官方 Codex CLI，未来可用性可能发生变化，并可能带来账号或政策风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服務使用你本機的官方 Codex CLI，未來可用性可能發生變化，並可能帶來帳號或政策風險。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует локальный официальный Codex CLI. Доступность может измениться; возможны риски для учётной записи или соблюдения правил."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовує локальний офіційний Codex CLI. Доступність може змінитися; можливі ризики для облікового запису або дотримання правил."
          }
        }
      }
    },
