    "service.claude_code.enable_risk_alert.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This service uses your locally installed and logged-in official Claude Code CLI. It does not use OAuth, private APIs, or proxy workarounds. Anthropic may change CLI policies or account rules in the future. Continue only if you understand and accept the potential account or policy risk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servicio usa la CLI oficial de Claude Code instalada localmente y con sesión iniciada. No usa OAuth, API privadas ni soluciones con proxy. Anthropic puede cambiar las políticas de la CLI o las reglas de cuenta en el futuro. Continúa solo si entiendes y aceptas el posible riesgo para la cuenta o las políticas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサービスは、ローカルにインストールされログイン済みの公式 Claude Code CLI を使用します。OAuth、非公開 API、プロキシによる回避策は使用しません。Anthropic は今後 CLI のポリシーやアカウント規則を変更する可能性があります。潜在的なアカウントやポリシーのリスクを理解し受け入れる場合のみ続行してください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto služba používa lokálne nainštalované a prihlásené oficiálne Claude Code CLI. Nepoužíva OAuth, súkromné API ani proxy obchádzky. Anthropic môže v budúcnosti zmeniť pravidlá CLI alebo účtov. Pokračujte iba vtedy, ak rozumiete možnému riziku pre účet alebo pravidlá a prijímate ho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务使用你本机已安装并已登录的官方 Claude Code CLI，不使用 OAuth、私有 API 或代理绕行方案。Anthropic 未来可能调整 CLI 政策或账号规则。仅当你理解并接受潜在的账号或政策风险时再继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服務使用你本機已安裝且已登入的官方 Claude Code CLI，不使用 OAuth、私有 API 或代理繞行方案。Anthropic 未來可能調整 CLI 政策或帳號規則。僅當你理解並接受潛在的帳號或政策風險時再繼續。"
          }
        }
      }
    },
