        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soporta las siguientes variables de entorno:\n\n${{queryText}}: Texto de consulta\n${{queryFromLanguage}}: Idioma de origen\n${{queryTargetLanguage}}: Idioma de destino\n${{firstLanguage}}: Primer idioma del usuario\n\nEjemplo: Traduce el siguiente texto de ${{queryFromLanguage}} a ${{queryTargetLanguage}}: ${{queryText}}"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下の環境変数をサポートしています:\n\n${{queryText}}: クエリテキスト\n${{queryFromLanguage}}: クエリ言語\n${{queryTargetLanguage}}: 対象言語\n${{firstLanguage}}: ユーザーの第一言語\n\n例: 次の ${{queryFromLanguage}} のテキストを ${{queryTargetLanguage}} に翻訳してください: ${{queryText}}"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podporuje nasledujúce premenné prostredia:\n\n${{queryText}}: Text dotazu\n${{queryFromLanguage}}: Jazyk dotazu\n${{queryTargetLanguage}}: Cieľový jazyk\n${{firstLanguage}}: Prvý jazyk používateľa\n\nPríklad: Prelož nasledujúci text ${{queryFromLanguage}} do ${{queryTargetLanguage}}: ${{queryText}}"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持以下环境变量：\n\n${{queryText}}: 查询文本\n${{queryFromLanguage}}: 查询语言\n${{queryTargetLanguage}}: 目标语言\n${{firstLanguage}}: 用户第一语言\n\n例如：Translate the following ${{queryFromLanguage}} text into ${{queryTargetLanguage}}: ${{queryText}}"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支援以下環境變數：\n\n${{queryText}}: 查詢文本\n${{queryFromLanguage}}: 查詢語言\n${{queryTargetLanguage}}: 目標語言\n${{firstLanguage}}: 使用者第一語言\n\n例如：Translate the following ${{queryFromLanguage}} text into ${{queryTargetLanguage}}: ${{queryText}}"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддерживаются следующие переменные окружения:\n\n${{queryText}}: Текст запроса\n${{queryFromLanguage}}: Исходный язык\n${{queryTargetLanguage}}: Язык перевода\n${{firstLanguage}}: Первый язык пользователя\n\nПример: Переведите следующий текст с языка ${{queryFromLanguage}} на язык ${{queryTargetLanguage}}: ${{queryText}}"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підтримуються такі змінні середовища:\n\n${{queryText}}: Текст запиту\n${{queryFromLanguage}}: Вихідна мова\n${{queryTargetLanguage}}: Мова перекладу\n${{firstLanguage}}: Перша мова користувача\n\nПриклад: Перекладіть наведений текст із мови ${{queryFromLanguage}} мовою ${{queryTargetLanguage}}: ${{queryText}}"
