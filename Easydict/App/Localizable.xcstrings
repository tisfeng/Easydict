      "grammar.analysis.provider.openai.footnote": {
        "extractionState": "stale",
        "localizations": {
          "ar": {
            "stringUnit": {
              "state": "translated",
              "value": "سيُملأ تلقائيًا Endpoint `chat/completions` الرسمي الخاص بـ OpenAI والنموذج الافتراضي الموصى به. وما زال بإمكانك تعديل Endpoint عند الحاجة."
            }
          },
          "bg": {
            "stringUnit": {
              "state": "translated",
              "value": "Автоматично попълва официалния Endpoint `chat/completions` на OpenAI и препоръчания модел по подразбиране. Endpoint все още може да се редактира при нужда."
            }
          },
          "bn": {
            "stringUnit": {
              "state": "translated",
              "value": "এটি OpenAI-এর অফিসিয়াল `chat/completions` Endpoint আর প্রস্তাবিত ডিফল্ট model আগে থেকেই বসিয়ে দেবে। প্রয়োজনে Endpoint আপনি এখনও বদলাতে পারবেন।"
            }
          },
          "ca": {
            "stringUnit": {
              "state": "translated",
              "value": "Omple automàticament l’Endpoint oficial `chat/completions` d’OpenAI i el model predeterminat recomanat. Encara pots editar l’Endpoint si cal."
            }
          },
          "cs": {
            "stringUnit": {
              "state": "translated",
              "value": "Automaticky předvyplní oficiální OpenAI `chat/completions` Endpoint a doporučený výchozí model. Endpoint můžete v případě potřeby stále upravit."
            }
          },
          "da": {
            "stringUnit": {
              "state": "translated",
              "value": "Udfylder automatisk OpenAIs officielle `chat/completions` Endpoint og den anbefalede standardmodel. Du kan stadig redigere Endpoint om nødvendigt."
            }
          },
          "de": {
            "stringUnit": {
              "state": "translated",
              "value": "Füllt automatisch den offiziellen `chat/completions`-Endpoint von OpenAI und das empfohlene Standardmodell aus. Bei Bedarf können Sie den Endpoint weiterhin bearbeiten."
            }
          },
          "el": {
            "stringUnit": {
              "state": "translated",
              "value": "Συμπληρώνει αυτόματα το επίσημο Endpoint `chat/completions` της OpenAI και το προτεινόμενο προεπιλεγμένο μοντέλο. Μπορείτε ακόμη να επεξεργαστείτε το Endpoint αν χρειάζεται."
            }
          },
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Pre-fills OpenAI's official chat/completions endpoint and the recommended default model. You can still edit the endpoint if needed."
            }
          },
          "es": {
            "stringUnit": {
              "state": "translated",
              "value": "Rellena automáticamente el endpoint oficial `chat/completions` de OpenAI y el modelo predeterminado recomendado. Aun así puedes editar el endpoint si lo necesitas."
            }
          },
          "et": {
            "stringUnit": {
              "state": "translated",
              "value": "Täidab automaatselt OpenAI ametliku `chat/completions` Endpointi ja soovitatud vaikemudeli. Vajadusel saate Endpointi siiski muuta."
            }
          },
          "fa": {
            "stringUnit": {
              "state": "translated",
              "value": "Endpoint رسمی `chat/completions` اوپن‌اِی‌آی و مدل پیش‌فرض پیشنهادی را به‌صورت خودکار پر می‌کند. در صورت نیاز همچنان می‌توانید Endpoint را ویرایش کنید."
            }
          },
          "fi": {
            "stringUnit": {
              "state": "translated",
              "value": "Täyttää automaattisesti OpenAI:n virallisen `chat/completions` Endpointin ja suositellun oletusmallin. Voit silti muokata Endpointia tarvittaessa."
            }
          },
          "fil": {
            "stringUnit": {
              "state": "translated",
              "value": "Awtomatikong pinupunan ang opisyal na `chat/completions` Endpoint ng OpenAI at ang inirerekomendang default model. Maaari mo pa ring baguhin ang Endpoint kung kailangan."
            }
          },
          "fr": {
            "stringUnit": {
              "state": "translated",
              "value": "Préremplit l’endpoint officiel `chat/completions` d’OpenAI et le modèle par défaut recommandé. Vous pouvez toujours modifier l’endpoint si nécessaire."
            }
          },
          "he": {
            "stringUnit": {
              "state": "translated",
              "value": "ממלא מראש את Endpoint ה-`chat/completions` הרשמי של OpenAI ואת מודל ברירת המחדל המומלץ. עדיין ניתן לערוך את ה-Endpoint לפי הצורך."
            }
          },
          "hi": {
            "stringUnit": {
              "state": "translated",
              "value": "यह OpenAI के आधिकारिक `chat/completions` Endpoint और अनुशंसित डिफ़ॉल्ट model को पहले से भर देता है। जरूरत पड़ने पर आप Endpoint को फिर भी बदल सकते हैं।"
            }
          },
          "hr": {
            "stringUnit": {
              "state": "translated",
              "value": "Automatski ispunjava službeni OpenAI `chat/completions` Endpoint i preporučeni zadani model. Endpoint i dalje možete urediti po potrebi."
            }
          },
          "hu": {
            "stringUnit": {
              "state": "translated",
              "value": "Automatikusan kitölti az OpenAI hivatalos `chat/completions` Endpointját és az ajánlott alapértelmezett modellt. Az Endpoint szükség esetén továbbra is szerkeszthető."
            }
          },
          "id": {
            "stringUnit": {
              "state": "translated",
              "value": "Secara otomatis mengisi Endpoint resmi `chat/completions` milik OpenAI dan model default yang direkomendasikan. Anda tetap bisa mengedit Endpoint jika diperlukan."
            }
          },
          "it": {
            "stringUnit": {
              "state": "translated",
              "value": "Compila automaticamente l’Endpoint ufficiale `chat/completions` di OpenAI e il modello predefinito consigliato. Puoi comunque modificare l’Endpoint se necessario."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "OpenAI 公式の chat/completions エンドポイントと推奨デフォルトモデルを自動入力します。必要に応じてエンドポイントは編集できます。"
            }
          },
          "ka": {
            "stringUnit": {
              "state": "translated",
              "value": "ავტომატურად ავსებს OpenAI-ის ოფიციალურ `chat/completions` Endpoint-ს და რეკომენდებულ ნაგულისხმებ მოდელს. საჭიროების შემთხვევაში Endpoint-ის შეცვლა კვლავ შეგიძლიათ."
            }
          },
          "km": {
            "stringUnit": {
              "state": "translated",
              "value": "វានឹងបំពេញ Endpoint `chat/completions` ផ្លូវការរបស់ OpenAI និងម៉ូដែលលំនាំដើមដែលបានណែនាំដោយស្វ័យប្រវត្តិ។ អ្នកនៅតែអាចកែ Endpoint បាន ប្រសិនបើចាំបាច់។"
            }
          },
          "ko": {
            "stringUnit": {
              "state": "translated",
              "value": "OpenAI 공식 `chat/completions` Endpoint와 권장 기본 모델을 자동으로 채워 넣습니다. 필요하면 Endpoint는 직접 수정할 수 있습니다."
            }
          },
          "lo": {
            "stringUnit": {
              "state": "translated",
              "value": "ຈະເຕີມ Endpoint `chat/completions` ທາງການຂອງ OpenAI ແລະໂມເດວເລີ່ມຕົ້ນທີ່ແນະນຳໃຫ້ໂດຍອັດຕະໂນມັດ. ທ່ານຍັງແກ້ Endpoint ເອງໄດ້ຖ້າຈຳເປັນ."
            }
          },
          "lt": {
            "stringUnit": {
              "state": "translated",
              "value": "Automatiškai užpildo oficialų OpenAI `chat/completions` Endpoint ir rekomenduojamą numatytąjį modelį. Jei reikia, Endpoint vis tiek galite redaguoti."
            }
          },
          "lv": {
            "stringUnit": {
              "state": "translated",
              "value": "Automātiski aizpilda OpenAI oficiālo `chat/completions` Endpoint un ieteikto noklusējuma modeļa vērtību. Vajadzības gadījumā Endpoint joprojām var rediģēt."
            }
          },
          "mn-Mong": {
            "stringUnit": {
              "state": "translated",
              "value": "OpenAI-ийн албан ёсны `chat/completions` Endpoint болон санал болгосон үндсэн загварыг автоматаар бөглөнө. Шаардлагатай бол Endpoint-ийг гараар өөрчилж болно."
            }
          },
          "ms": {
            "stringUnit": {
              "state": "translated",
              "value": "Mengisi secara automatik Endpoint rasmi `chat/completions` OpenAI dan model lalai yang disyorkan. Anda masih boleh mengedit Endpoint jika perlu."
            }
          },
          "my": {
            "stringUnit": {
              "state": "translated",
              "value": "OpenAI ၏ တရားဝင် `chat/completions` Endpoint နှင့် အကြံပြု default model ကို အလိုအလျောက်ဖြည့်ပေးမည်။ လိုအပ်ပါက Endpoint ကို သင်တိုင် ပြင်ဆင်နိုင်ပါသည်."
            }
          },
          "nb": {
            "stringUnit": {
              "state": "translated",
              "value": "Fyller automatisk inn OpenAIs offisielle `chat/completions` Endpoint og den anbefalte standardmodellen. Du kan fortsatt redigere Endpoint ved behov."
            }
          },
          "nl": {
            "stringUnit": {
              "state": "translated",
              "value": "Vult automatisch de officiële `chat/completions` Endpoint van OpenAI en het aanbevolen standaardmodel in. Je kunt de Endpoint nog steeds aanpassen indien nodig."
            }
          },
          "pl": {
            "stringUnit": {
              "state": "translated",
              "value": "Automatycznie uzupełnia oficjalny Endpoint `chat/completions` OpenAI oraz zalecany domyślny model. W razie potrzeby nadal możesz edytować Endpoint ręcznie."
            }
          },
          "pt": {
            "stringUnit": {
              "state": "translated",
              "value": "Preenche automaticamente o Endpoint oficial `chat/completions` da OpenAI e o modelo predefinido recomendado. Ainda pode editar o Endpoint, se necessário."
            }
          },
          "pt-BR": {
            "stringUnit": {
              "state": "translated",
              "value": "Preenche automaticamente o Endpoint oficial `chat/completions` da OpenAI e o modelo padrão recomendado. Você ainda pode editar o Endpoint, se precisar."
            }
          },
          "ro": {
            "stringUnit": {
              "state": "translated",
              "value": "Completează automat Endpoint-ul oficial `chat/completions` al OpenAI și modelul implicit recomandat. Poți totuși să editezi Endpoint-ul dacă este nevoie."
            }
          },
          "ru": {
            "stringUnit": {
              "state": "translated",
              "value": "Автоматически заполняет официальный `chat/completions` Endpoint OpenAI и рекомендуемую модель по умолчанию. При необходимости Endpoint всё ещё можно изменить вручную."
            }
          },
          "sk": {
            "stringUnit": {
              "state": "translated",
              "value": "Predvyplní oficiálny OpenAI endpoint chat/completions a odporúčaný predvolený model. Endpoint môžete podľa potreby upraviť."
            }
          },
          "sl": {
            "stringUnit": {
              "state": "translated",
              "value": "Samodejno izpolni uradni OpenAI `chat/completions` Endpoint in priporočeni privzeti model. Endpoint lahko po potrebi še vedno uredite."
            }
          },
          "sr-Cyrl": {
            "stringUnit": {
              "state": "translated",
              "value": "Аутоматски попуњава OpenAI званични `chat/completions` Endpoint и препоручени подразумевани модел. Endpoint и даље можете уредити ако затреба."
            }
          },
          "sv": {
            "stringUnit": {
              "state": "translated",
              "value": "Fyller automatiskt i OpenAIs officiella `chat/completions` Endpoint och den rekommenderade standardmodellen. Du kan fortfarande redigera Endpoint vid behov."
            }
          },
          "ta": {
            "stringUnit": {
              "state": "translated",
              "value": "OpenAI-யின் அதிகாரப்பூர்வ `chat/completions` Endpoint மற்றும் பரிந்துரைக்கப்பட்ட இயல்புநிலை model-ஐ தானாக நிரப்பும். தேவையெனில் Endpoint-ஐ நீங்கள் இன்னும் மாற்றலாம்."
            }
          },
          "te": {
            "stringUnit": {
              "state": "translated",
              "value": "OpenAI యొక్క అధికారిక `chat/completions` Endpoint మరియు సిఫార్సు చేసిన default model‌ను ఇది స్వయంచాలకంగా నింపుతుంది. అవసరమైతే మీరు Endpoint‌ను ఇంకా మార్చవచ్చు."
            }
          },
          "th": {
            "stringUnit": {
              "state": "translated",
              "value": "ระบบจะกรอก Endpoint `chat/completions` ทางการของ OpenAI และโมเดลเริ่มต้นที่แนะนำให้อัตโนมัติ คุณยังแก้ไข Endpoint เองได้หากจำเป็น"
            }
          },
          "tr": {
            "stringUnit": {
              "state": "translated",
              "value": "OpenAI’nin resmî `chat/completions` Endpointini ve önerilen varsayılan modeli otomatik olarak doldurur. Gerekirse Endpointi yine düzenleyebilirsiniz."
            }
          },
          "ug": {
            "stringUnit": {
              "state": "translated",
              "value": "OpenAI نىڭ رەسمىي `chat/completions` Endpoint ى ۋە تەۋسىيە قىلىنغان كۆڭۈلدىكى مودېلىنى ئاپتوماتىك تولدۇرىدۇ. زۆرۈر بولسا Endpoint نى يەنىلا قولدا ئۆزگەرتەلەيسىز."
            }
          },
          "uk": {
            "stringUnit": {
              "state": "translated",
              "value": "Автоматично заповнює офіційний Endpoint `chat/completions` OpenAI і рекомендовану типову модель. За потреби Endpoint все одно можна відредагувати."
            }
          },
          "ur": {
            "stringUnit": {
              "state": "translated",
              "value": "یہ OpenAI کے سرکاری `chat/completions` Endpoint اور تجویز کردہ default model کو خودکار طور پر بھر دیتا ہے۔ ضرورت ہو تو آپ Endpoint کو پھر بھی تبدیل کر سکتے ہیں۔"
            }
          },
          "vi": {
            "stringUnit": {
              "state": "translated",
              "value": "Tự động điền Endpoint `chat/completions` chính thức của OpenAI và model mặc định được đề xuất. Bạn vẫn có thể chỉnh sửa Endpoint nếu cần."
            }
          },
          "zh-Hans": {
            "stringUnit": {
              "state": "translated",
              "value": "会自动填入 OpenAI 官方 `chat/completions` 地址和推荐默认模型，你仍然可以按需修改 Endpoint。"
            }
          },
          "zh-Hant": {
            "stringUnit": {
              "state": "translated",
              "value": "會自動填入 OpenAI 官方 `chat/completions` 位址與建議預設模型，你仍可依需求修改 Endpoint。"
            }
          }
        }
      },
