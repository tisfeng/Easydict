    "service.configuration.apple.offline_translation.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline translation requires downloading languages on the device. Use System Settings to [manage downloaded languages](x-apple.systempreferences:com.apple.Localization-Settings.extension?translation)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La traducción sin conexión requiere descargar idiomas en el dispositivo. En Configuración del Sistema puedes [gestionar los idiomas descargados](x-apple.systempreferences:com.apple.Localization-Settings.extension?translation)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフライン翻訳にはデバイスへの言語のダウンロードが必要です。システム設定では、[ダウンロードした言語の管理](x-apple.systempreferences:com.apple.Localization-Settings.extension?translation)を行えます。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline preklad vyžaduje stiahnutie jazykov do zariadenia. V Systémových nastaveniach môžete [spravovať stiahnuté jazyky](x-apple.systempreferences:com.apple.Localization-Settings.extension?translation)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离线翻译需要在设备上下载语言，可通过系统设置[管理下载语言](x-apple.systempreferences:com.apple.Localization-Settings.extension?translation)。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離線翻譯需要在裝置上下載語言，可透過系統設定[管理下載語言](x-apple.systempreferences:com.apple.Localization-Settings.extension?translation)。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для перевода без интернета нужно загрузить языки на устройство. В системных настройках можно [управлять загруженными языками](x-apple.systempreferences:com.apple.Localization-Settings.extension?translation)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для перекладу без інтернету потрібно завантажити мови на пристрій. У системних параметрах можна [керувати завантаженими мовами](x-apple.systempreferences:com.apple.Localization-Settings.extension?translation)."
          }
        }
      }
