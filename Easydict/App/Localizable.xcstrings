    "setting.advance.auto_show_query_icon.condition.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the query icon only when the selected text language differs and the character count reaches this value."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar el icono de consulta solo cuando el idioma del texto seleccionado sea diferente y la cantidad de caracteres alcance este valor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したテキストの言語が異なり、かつ文字数がこの値に達した場合のみクエリアイコンを表示します。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the query icon only when the selected text language differs and the character count reaches this value."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当选中文本语言≠指定语言 且 字符数≥该值时显示查询图标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅當選取文本語言≠指定語言 且 字元數≥該值時顯示查詢圖示。"
          }
        }
      }
    },
