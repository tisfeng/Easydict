    "setting.advance.apple_offline_translation_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline translation requires downloading languages on the device, which can be managed in \"System Settings\"."
          }
