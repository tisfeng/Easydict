      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When custom prompt is enabled, the default translation, sentence analysis, and dictionary prompt will be disabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el prompt personalizado está habilitado, el prompt de traducción, análisis de oraciones y diccionario por defecto serán deshabilitados."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
