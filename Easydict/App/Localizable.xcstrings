    "service.github_copilot.risk_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses your local official GitHub Copilot CLI. Availability may change in the future and may carry account or policy risk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tu CLI oficial local de GitHub Copilot. La disponibilidad puede cambiar en el futuro y puede implicar riesgos para la cuenta o de política."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルの公式 GitHub Copilot CLI を使用します。可用性は将来変更される可能性があり、アカウントやポリシー上のリスクを伴う場合があります。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používa váš lokálny oficiálny GitHub Copilot CLI. Dostupnosť sa môže v budúcnosti zmeniť a môže predstavovať riziko pre účet alebo politiku."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你本地安装的官方 GitHub Copilot CLI。可用性未来可能变化，并可能带来账户或政策风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你本地安裝的官方 GitHub Copilot CLI。可用性未來可能變化，並可能帶來帳戶或政策風險。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует локальный официальный GitHub Copilot CLI. Доступность может измениться; возможны риски для учётной записи или соблюдения правил."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовує локальний офіційний GitHub Copilot CLI. Доступність може змінитися; можливі ризики для облікового запису або дотримання правил."
          }
        }
      }
    },
