      "grammar.analysis.missing_model": {
        "localizations": {
          "ar": {
            "stringUnit": {
              "state": "translated",
              "value": "يُرجى أولاً جلب Supported Models أو تعبئتها، ثم اختيار نموذج واحد."
            }
          },
          "bg": {
            "stringUnit": {
              "state": "translated",
              "value": "Моля, първо извлечете или попълнете Supported Models и след това изберете един модел."
            }
          },
          "bn": {
            "stringUnit": {
              "state": "translated",
              "value": "দয়া করে আগে Supported Models টেনে আনুন বা পূরণ করুন, তারপর একটি মডেল বেছে নিন।"
            }
          },
          "ca": {
            "stringUnit": {
              "state": "translated",
              "value": "Primer recupera o omple Supported Models i després tria un model."
            }
          },
          "cs": {
            "stringUnit": {
              "state": "translated",
              "value": "Nejprve načtěte nebo vyplňte Supported Models a potom vyberte jeden model."
            }
          },
          "da": {
            "stringUnit": {
              "state": "translated",
              "value": "Hent eller udfyld først Supported Models, og vælg derefter én model."
            }
          },
          "de": {
            "stringUnit": {
              "state": "translated",
              "value": "Bitte rufen Sie zuerst Supported Models ab oder tragen Sie sie ein und wählen Sie dann ein Modell aus."
            }
          },
          "el": {
            "stringUnit": {
              "state": "translated",
              "value": "Ανακτήστε ή συμπληρώστε πρώτα τα Supported Models και έπειτα επιλέξτε ένα μοντέλο."
            }
          },
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Please fetch or fill in Supported Models first, then choose one model."
            }
          },
          "es": {
            "stringUnit": {
              "state": "translated",
              "value": "Primero obtén o rellena Modelos compatibles y luego elige un modelo."
            }
          },
          "et": {
            "stringUnit": {
              "state": "translated",
              "value": "Too esmalt Supported Models või täitke see ja seejärel valige üks mudel."
            }
          },
          "fa": {
            "stringUnit": {
              "state": "translated",
              "value": "لطفاً ابتدا Supported Models را دریافت یا تکمیل کنید و سپس یک مدل را انتخاب کنید."
            }
          },
          "fi": {
            "stringUnit": {
              "state": "translated",
              "value": "Hae tai täytä ensin Supported Models ja valitse sitten yksi malli."
            }
          },
          "fil": {
            "stringUnit": {
              "state": "translated",
              "value": "Pakikuha o punan muna ang Supported Models, pagkatapos ay pumili ng isang modelo."
            }
          },
          "fr": {
            "stringUnit": {
              "state": "translated",
              "value": "Récupérez ou renseignez d’abord les Supported Models, puis choisissez un modèle."
            }
          },
          "he": {
            "stringUnit": {
              "state": "translated",
              "value": "יש למשוך או למלא תחילה את Supported Models ולאחר מכן לבחור מודל אחד."
            }
          },
          "hi": {
            "stringUnit": {
              "state": "translated",
              "value": "कृपया पहले Supported Models प्राप्त करें या भरें, फिर एक मॉडल चुनें।"
            }
          },
          "hr": {
            "stringUnit": {
              "state": "translated",
              "value": "Najprije dohvatite ili ispunite Supported Models, a zatim odaberite jedan model."
            }
          },
          "hu": {
            "stringUnit": {
              "state": "translated",
              "value": "Először töltse le vagy adja meg a Supported Models értékeit, majd válasszon egy modellt."
            }
          },
          "id": {
            "stringUnit": {
              "state": "translated",
              "value": "Silakan ambil atau isi Supported Models terlebih dahulu, lalu pilih satu model."
            }
          },
          "it": {
            "stringUnit": {
              "state": "translated",
              "value": "Recupera o compila prima Supported Models, poi scegli un modello."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "先に対応モデルを取得または入力してから、使用モデルを選択してください。"
            }
          },
          "ka": {
            "stringUnit": {
              "state": "translated",
              "value": "ჯერ მოითხოვეთ ან შეავსეთ Supported Models, შემდეგ კი აირჩიეთ ერთი მოდელი."
            }
          },
          "km": {
            "stringUnit": {
              "state": "translated",
              "value": "សូមទាញយក ឬបំពេញ Supported Models ជាមុនសិន បន្ទាប់មកជ្រើសរើសម៉ូដែលមួយ។"
            }
          },
          "ko": {
            "stringUnit": {
              "state": "translated",
              "value": "먼저 Supported Models를 가져오거나 입력한 뒤 사용할 모델 하나를 선택하세요."
            }
          },
          "lo": {
            "stringUnit": {
              "state": "translated",
              "value": "ກະລຸນາດຶງຫຼືກອກ Supported Models ກ່ອນ ແລ້ວຈຶ່ງເລືອກໂມເດວໜຶ່ງ."
            }
          },
          "lt": {
            "stringUnit": {
              "state": "translated",
              "value": "Pirmiausia nuskaitykite arba užpildykite Supported Models, tada pasirinkite vieną modelį."
            }
          },
          "lv": {
            "stringUnit": {
              "state": "translated",
              "value": "Vispirms iegūstiet vai aizpildiet Supported Models un pēc tam izvēlieties vienu modeli."
            }
          },
          "mn-Mong": {
            "stringUnit": {
              "state": "translated",
              "value": "Эхлээд Supported Models-ийг татаж авах эсвэл бөглөж, дараа нь нэг загвар сонгоно уу."
            }
          },
          "ms": {
            "stringUnit": {
              "state": "translated",
              "value": "Sila ambil atau isi Supported Models terlebih dahulu, kemudian pilih satu model."
            }
          },
          "my": {
            "stringUnit": {
              "state": "translated",
              "value": "ကျေးဇူးပြု၍ Supported Models ကို အရင်ရယူပါ သို့မဟုတ် ဖြည့်ပါ၊ ထို့နောက် မော်ဒယ်တစ်ခုကို ရွေးပါ။"
            }
          },
          "nb": {
            "stringUnit": {
              "state": "translated",
              "value": "Hent eller fyll inn Supported Models først, og velg deretter én modell."
            }
          },
          "nl": {
            "stringUnit": {
              "state": "translated",
              "value": "Haal eerst Supported Models op of vul ze in en kies daarna één model."
            }
          },
          "pl": {
            "stringUnit": {
              "state": "translated",
              "value": "Najpierw pobierz lub uzupełnij Supported Models, a następnie wybierz jeden model."
            }
          },
          "pt": {
            "stringUnit": {
              "state": "translated",
              "value": "Primeiro obtenha ou preencha Supported Models e depois escolha um modelo."
            }
          },
          "pt-BR": {
            "stringUnit": {
              "state": "translated",
              "value": "Primeiro busque ou preencha Supported Models e depois escolha um modelo."
            }
          },
          "ro": {
            "stringUnit": {
              "state": "translated",
              "value": "Mai întâi preia sau completează Supported Models, apoi alege un model."
            }
          },
          "ru": {
            "stringUnit": {
              "state": "translated",
              "value": "Сначала получите или заполните Supported Models, а затем выберите одну модель."
            }
          },
          "sk": {
            "stringUnit": {
              "state": "translated",
              "value": "Najprv načítajte alebo zadajte podporované modely a potom vyberte jeden model."
            }
          },
          "sl": {
            "stringUnit": {
              "state": "translated",
              "value": "Najprej pridobite ali izpolnite Supported Models, nato izberite en model."
            }
          },
          "sr-Cyrl": {
            "stringUnit": {
              "state": "translated",
              "value": "Прво преузмите или попуните Supported Models, па затим изаберите један модел."
            }
          },
          "sv": {
            "stringUnit": {
              "state": "translated",
              "value": "Hämta eller fyll först i Supported Models och välj sedan en modell."
            }
          },
          "ta": {
            "stringUnit": {
              "state": "translated",
              "value": "முதலில் Supported Models-ஐ பெறுங்கள் அல்லது நிரப்புங்கள், பின்னர் ஒரு மாடலைத் தேர்ந்தெடுக்கவும்."
            }
          },
          "te": {
            "stringUnit": {
              "state": "translated",
              "value": "దయచేసి ముందుగా Supported Models‌ను పొందండి లేదా పూరించండి, ఆ తర్వాత ఒక మోడల్‌ను ఎంచుకోండి."
            }
          },
          "th": {
            "stringUnit": {
              "state": "translated",
              "value": "โปรดดึงหรือกรอก Supported Models ก่อน แล้วค่อยเลือกโมเดลหนึ่งรายการ"
            }
          },
          "tr": {
            "stringUnit": {
              "state": "translated",
              "value": "Lütfen önce Supported Models listesini alın veya doldurun, ardından bir model seçin."
            }
          },
          "ug": {
            "stringUnit": {
              "state": "translated",
              "value": "ئاۋۋال Supported Models نى تارتىۋېلىڭ ياكى تولدۇرۇڭ، ئاندىن بىر مودېل تاللاڭ."
            }
          },
          "uk": {
            "stringUnit": {
              "state": "translated",
              "value": "Спочатку отримайте або заповніть Supported Models, а потім виберіть одну модель."
            }
          },
          "ur": {
            "stringUnit": {
              "state": "translated",
              "value": "براہِ کرم پہلے Supported Models حاصل کریں یا بھریں، پھر ایک ماڈل منتخب کریں۔"
            }
          },
          "vi": {
            "stringUnit": {
              "state": "translated",
              "value": "Vui lòng tải hoặc điền Supported Models trước, sau đó chọn một model."
            }
          },
          "zh-Hans": {
            "stringUnit": {
              "state": "translated",
              "value": "请先拉取或填写 Supported Models，再选择一个使用模型。"
            }
          },
          "zh-Hant": {
            "stringUnit": {
              "state": "translated",
              "value": "請先擷取或填寫 Supported Models，再選擇一個使用模型。"
            }
          }
        }
      },
