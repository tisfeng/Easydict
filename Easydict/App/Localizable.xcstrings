    "setting.advance.auto_select_all_text_field_text_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If no text is currently selected in the text field, automatically select all text content during translate and replace operations"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no hay texto seleccionado actualmente en el campo de texto, seleccionar automáticamente todo el contenido del texto durante las operaciones de traducción y reemplazo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストフィールドで現在テキストが選択されていない場合、翻訳・置換操作時にすべてのテキストを自動的に選択します"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak nie je v poli aktuálne vybraný žiadny text, automaticky vybrať všetok obsah textu pri prekladových a nahrádzacích operáciách"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果当前输入框中未选中文本，在翻译并替换操作时，允许自动全选文本内容"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果當前輸入框中未選中文本，在翻譯並替換操作時，允許自動全選文本內容"
          }
        }
      }
    },
