    "setting.general.display.enable_markdown_rendering.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI translation results render headings, lists, and emphasis as formatted text. Click the icon next to a result to override per card."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resultados de traducción de IA renderizan encabezados, listas y énfasis como texto con formato. Haz clic en el icono junto a un resultado para cambiarlo por tarjeta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 翻訳結果の見出し、リスト、強調を整形済みテキストとして表示します。各結果の横にあるアイコンをクリックすると、カードごとに切り替えられます。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výsledky AI prekladov sa zobrazia s nadpismi, zoznamami a zvýrazneniami. Pre prepnutie pre jednotlivý výsledok kliknite na ikonu vedľa neho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 翻译结果将以 Markdown 格式呈现标题、列表与强调。点击单个结果旁的图标可临时切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 翻譯結果將以 Markdown 格式呈現標題、清單與強調。點擊單個結果旁的圖示可臨時切換。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отображать заголовки, списки и выделение в ответах ИИ с форматированием. Значок рядом с результатом меняет режим для отдельной карточки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відображати заголовки, списки та виділення у відповідях ШІ з форматуванням. Значок біля результату змінює режим для окремої картки."
          }
        }
      }
    },
