    },
    "service.github_copilot.enable_risk_alert.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This service uses your locally installed and logged-in official GitHub Copilot CLI. It does not use OAuth, private APIs, or proxy workarounds, and it never reads or stores your Copilot token. GitHub may change CLI policies or account rules in the future. Continue only if you understand and accept the potential account or policy risk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servicio usa tu CLI oficial de GitHub Copilot instalado y con sesión iniciada localmente. No usa OAuth, API privadas ni intermediarios, y nunca lee ni almacena tu token de Copilot. GitHub puede cambiar las políticas del CLI o las reglas de cuenta en el futuro. Continúa solo si entiendes y aceptas el posible riesgo para la cuenta o de política."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサービスは、ローカルにインストールしてログイン済みの公式 GitHub Copilot CLI を使用します。OAuth、非公開 API、プロキシによる回避は使用せず、Copilot トークンを読み取ったり保存したりしません。GitHub は将来 CLI のポリシーやアカウント規則を変更する可能性があります。想定されるアカウントまたはポリシー上のリスクを理解し、受け入れる場合のみ続行してください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto služba používa váš lokálne nainštalovaný a prihlásený oficiálny GitHub Copilot CLI. Nepoužíva OAuth, súkromné API ani proxy obchádzky a nikdy nečíta ani neukladá váš token Copilot. GitHub môže v budúcnosti zmeniť politiky CLI alebo pravidlá účtu. Pokračujte len vtedy, ak rozumiete možnému riziku pre účet alebo politiku a prijímate ho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本服务使用你本地安装并已登录的官方 GitHub Copilot CLI，不使用 OAuth、私有 API 或代理绕过，也绝不读取或保存你的 Copilot token。GitHub 未来可能调整 CLI 政策或账户规则。请在你理解并接受潜在账户或政策风险后再继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本服務使用你本地安裝並已登入的官方 GitHub Copilot CLI，不使用 OAuth、私有 API 或代理繞過，也絕不讀取或保存你的 Copilot token。GitHub 未來可能調整 CLI 政策或帳戶規則。請在你理解並接受潛在帳戶或政策風險後再繼續。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот сервис использует установленный на вашем компьютере официальный GitHub Copilot CLI с выполненным входом. OAuth, закрытые API и обходные прокси не используются; токен Copilot никогда не читается и не сохраняется. GitHub может изменить правила CLI или учётных записей. Продолжайте, только если понимаете и принимаете возможные риски для учётной записи или соблюдения правил."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей сервіс використовує встановлений на вашому комп’ютері офіційний GitHub Copilot CLI з виконаним входом. OAuth, закриті API та обхідні проксі не використовуються; токен Copilot ніколи не читається й не зберігається. GitHub може змінити правила CLI або облікових записів. Продовжуйте, лише якщо розумієте й приймаєте можливі ризики для облікового запису або дотримання правил."
          }
        }
      }
    },
