      "grammar.analysis.provider.custom_compatible.footnote": {
        "extractionState": "stale",
        "localizations": {
          "ar": {
            "stringUnit": {
              "state": "translated",
              "value": "استخدم أي Endpoint متوافق مع OpenAI من نوع `chat/completions`. املأ الـ Endpoint والنماذج بنفسك، أو استخدم Fetch Models إذا كان المزوّد يدعم ذلك."
            }
          },
          "bg": {
            "stringUnit": {
              "state": "translated",
              "value": "Използвайте всеки OpenAI-съвместим `chat/completions` Endpoint. Попълнете сами Endpoint и моделите или използвайте Fetch Models, ако доставчикът го поддържа."
            }
          },
          "bn": {
            "stringUnit": {
              "state": "translated",
              "value": "যেকোনো OpenAI-compatible `chat/completions` Endpoint ব্যবহার করুন। Endpoint আর model নিজে পূরণ করুন, অথবা provider সমর্থন করলে Fetch Models ব্যবহার করুন।"
            }
          },
          "ca": {
            "stringUnit": {
              "state": "translated",
              "value": "Utilitza qualsevol Endpoint `chat/completions` compatible amb OpenAI. Omple tu mateix l’Endpoint i els models, o bé usa Fetch Models si el proveïdor ho admet."
            }
          },
          "cs": {
            "stringUnit": {
              "state": "translated",
              "value": "Použijte libovolný OpenAI-kompatibilní `chat/completions` Endpoint. Endpoint a modely vyplňte sami, případně použijte Fetch Models, pokud to poskytovatel podporuje."
            }
          },
          "da": {
            "stringUnit": {
              "state": "translated",
              "value": "Brug et vilkårligt OpenAI-kompatibelt `chat/completions` Endpoint. Udfyld selv Endpoint og modeller, eller brug Fetch Models, hvis udbyderen understøtter det."
            }
          },
          "de": {
            "stringUnit": {
              "state": "translated",
              "value": "Verwenden Sie einen beliebigen OpenAI-kompatiblen `chat/completions`-Endpoint. Tragen Sie Endpoint und Modelle selbst ein oder verwenden Sie Fetch Models, wenn der Anbieter dies unterstützt."
            }
          },
          "el": {
            "stringUnit": {
              "state": "translated",
              "value": "Χρησιμοποιήστε οποιοδήποτε συμβατό με OpenAI `chat/completions` Endpoint. Συμπληρώστε μόνοι σας το Endpoint και τα μοντέλα ή χρησιμοποιήστε το Fetch Models, αν το υποστηρίζει ο πάροχος."
            }
          },
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Use any OpenAI-compatible chat/completions endpoint. Fill in the endpoint and models yourself, or fetch models if the provider supports it."
            }
          },
          "es": {
            "stringUnit": {
              "state": "translated",
              "value": "Usa cualquier endpoint `chat/completions` compatible con OpenAI. Rellena el endpoint y los modelos manualmente, o recupéralos si el proveedor lo permite."
            }
          },
          "et": {
            "stringUnit": {
              "state": "translated",
              "value": "Kasutage mis tahes OpenAI-ga ühilduvat `chat/completions` Endpointi. Täitke Endpoint ja mudelid ise või kasutage Fetch Models funktsiooni, kui teenusepakkuja seda toetab."
            }
          },
          "fa": {
            "stringUnit": {
              "state": "translated",
              "value": "از هر Endpoint سازگار با OpenAI از نوع `chat/completions` استفاده کنید. Endpoint و مدل‌ها را خودتان وارد کنید، یا اگر ارائه‌دهنده پشتیبانی می‌کند از Fetch Models استفاده کنید."
            }
          },
          "fi": {
            "stringUnit": {
              "state": "translated",
              "value": "Käytä mitä tahansa OpenAI-yhteensopivaa `chat/completions` Endpointia. Täytä Endpoint ja mallit itse tai käytä Fetch Models -toimintoa, jos palveluntarjoaja tukee sitä."
            }
          },
          "fil": {
            "stringUnit": {
              "state": "translated",
              "value": "Gumamit ng anumang OpenAI-compatible na `chat/completions` Endpoint. Ikaw mismo ang maglagay ng Endpoint at mga modelo, o gumamit ng Fetch Models kung sinusuportahan ito ng provider."
            }
          },
          "fr": {
            "stringUnit": {
              "state": "translated",
              "value": "Utilisez n’importe quel endpoint `chat/completions` compatible OpenAI. Renseignez vous-même l’endpoint et les modèles, ou utilisez Fetch Models si le fournisseur le prend en charge."
            }
          },
          "he": {
            "stringUnit": {
              "state": "translated",
              "value": "השתמש בכל Endpoint תואם OpenAI מסוג `chat/completions`. מלא בעצמך את ה-Endpoint ואת המודלים, או השתמש ב-Fetch Models אם הספק תומך בכך."
            }
          },
          "hi": {
            "stringUnit": {
              "state": "translated",
              "value": "किसी भी OpenAI-compatible `chat/completions` Endpoint का उपयोग करें। Endpoint और models खुद भरें, या अगर provider सपोर्ट करता हो तो Fetch Models इस्तेमाल करें।"
            }
          },
          "hr": {
            "stringUnit": {
              "state": "translated",
              "value": "Koristite bilo koji OpenAI-kompatibilan `chat/completions` Endpoint. Endpoint i modele unesite sami ili upotrijebite Fetch Models ako to pružatelj podržava."
            }
          },
          "hu": {
            "stringUnit": {
              "state": "translated",
              "value": "Bármilyen OpenAI-kompatibilis `chat/completions` Endpoint használható. Az Endpointot és a modelleket adja meg kézzel, vagy használja a Fetch Models lehetőséget, ha a szolgáltató támogatja."
            }
          },
          "id": {
            "stringUnit": {
              "state": "translated",
              "value": "Gunakan Endpoint `chat/completions` apa pun yang kompatibel dengan OpenAI. Isi sendiri Endpoint dan modelnya, atau gunakan Fetch Models jika penyedia mendukungnya."
            }
          },
          "it": {
            "stringUnit": {
              "state": "translated",
              "value": "Usa qualsiasi Endpoint `chat/completions` compatibile con OpenAI. Compila manualmente Endpoint e modelli oppure usa Fetch Models se il provider lo supporta."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "任意の OpenAI 互換 chat/completions エンドポイントを使用します。エンドポイントとモデルは自分で入力するか、対応していればモデル取得を使ってください。"
            }
          },
          "ka": {
            "stringUnit": {
              "state": "translated",
              "value": "გამოიყენეთ ნებისმიერი OpenAI-თავსებადი `chat/completions` Endpoint. Endpoint და მოდელები თავად შეავსეთ, ან გამოიყენეთ Fetch Models, თუ provider ამას მხარს უჭერს."
            }
          },
          "km": {
            "stringUnit": {
              "state": "translated",
              "value": "ប្រើ Endpoint `chat/completions` ណាមួយដែលឆបគ្នានឹង OpenAI។ សូមបំពេញ Endpoint និងម៉ូដែលដោយខ្លួនឯង ឬប្រើ Fetch Models ប្រសិនបើអ្នកផ្ដល់សេវាគាំទ្រ។"
            }
          },
          "ko": {
            "stringUnit": {
              "state": "translated",
              "value": "OpenAI 호환 `chat/completions` Endpoint라면 무엇이든 사용할 수 있습니다. Endpoint와 모델은 직접 입력하거나, 제공자가 지원하면 Fetch Models를 사용하세요."
            }
          },
          "lo": {
            "stringUnit": {
              "state": "translated",
              "value": "ໃຊ້ Endpoint `chat/completions` ທີ່ເຂົ້າກັນໄດ້ກັບ OpenAI ໃດກໍໄດ້. ກອກ Endpoint ແລະໂມເດວດ້ວຍຕົນເອງ ຫຼືໃຊ້ Fetch Models ຖ້າ provider ຮອງຮັບ."
            }
          },
          "lt": {
            "stringUnit": {
              "state": "translated",
              "value": "Naudokite bet kurį su OpenAI suderinamą `chat/completions` Endpoint. Endpoint ir modelius užpildykite patys arba naudokite Fetch Models, jei teikėjas tai palaiko."
            }
          },
          "lv": {
            "stringUnit": {
              "state": "translated",
              "value": "Izmantojiet jebkuru ar OpenAI saderīgu `chat/completions` Endpoint. Ievadiet Endpoint un modeļus paši vai izmantojiet Fetch Models, ja pakalpojumu sniedzējs to atbalsta."
            }
          },
          "mn-Mong": {
            "stringUnit": {
              "state": "translated",
              "value": "OpenAI-тэй нийцтэй дурын `chat/completions` Endpoint ашиглана уу. Endpoint болон загваруудыг өөрөө бөглөх эсвэл нийлүүлэгч дэмждэг бол Fetch Models ашиглана уу."
            }
          },
          "ms": {
            "stringUnit": {
              "state": "translated",
              "value": "Gunakan mana-mana Endpoint `chat/completions` yang serasi dengan OpenAI. Isi Endpoint dan model sendiri, atau gunakan Fetch Models jika penyedia menyokongnya."
            }
          },
          "my": {
            "stringUnit": {
              "state": "translated",
              "value": "OpenAI နှင့် ကိုက်ညီသော `chat/completions` Endpoint မည်သည့်တစ်ခုကိုမဆို အသုံးပြုပါ။ Endpoint နှင့် model များကို ကိုယ်တိုင်ဖြည့်ပါ၊ သို့မဟုတ် provider က ပံ့ပိုးလျှင် Fetch Models ကို သုံးပါ။"
            }
          },
          "nb": {
            "stringUnit": {
              "state": "translated",
              "value": "Bruk en hvilken som helst OpenAI-kompatibel `chat/completions` Endpoint. Fyll inn Endpoint og modeller selv, eller bruk Fetch Models hvis leverandøren støtter det."
            }
          },
          "nl": {
            "stringUnit": {
              "state": "translated",
              "value": "Gebruik een willekeurige OpenAI-compatibele `chat/completions` Endpoint. Vul de Endpoint en modellen zelf in, of gebruik Fetch Models als de provider dat ondersteunt."
            }
          },
          "pl": {
            "stringUnit": {
              "state": "translated",
              "value": "Użyj dowolnego zgodnego z OpenAI Endpointu `chat/completions`. Wpisz Endpoint i modele ręcznie albo użyj Fetch Models, jeśli dostawca to obsługuje."
            }
          },
          "pt": {
            "stringUnit": {
              "state": "translated",
              "value": "Use qualquer Endpoint `chat/completions` compatível com OpenAI. Preencha o Endpoint e os modelos manualmente ou use Fetch Models se o fornecedor oferecer suporte."
            }
          },
          "pt-BR": {
            "stringUnit": {
              "state": "translated",
              "value": "Use qualquer Endpoint `chat/completions` compatível com OpenAI. Preencha o Endpoint e os modelos manualmente ou use Fetch Models se o provedor oferecer suporte."
            }
          },
          "ro": {
            "stringUnit": {
              "state": "translated",
              "value": "Folosește orice Endpoint `chat/completions` compatibil cu OpenAI. Completează manual Endpoint-ul și modelele sau folosește Fetch Models dacă furnizorul acceptă acest lucru."
            }
          },
          "ru": {
            "stringUnit": {
              "state": "translated",
              "value": "Используйте любой OpenAI-совместимый `chat/completions` Endpoint. Заполните Endpoint и модели вручную или используйте Fetch Models, если провайдер это поддерживает."
            }
          },
          "sk": {
            "stringUnit": {
              "state": "translated",
              "value": "Použite ľubovoľný OpenAI-kompatibilný endpoint chat/completions. Endpoint a modely zadajte ručne alebo ich načítajte, ak to poskytovateľ podporuje."
            }
          },
          "sl": {
            "stringUnit": {
              "state": "translated",
              "value": "Uporabite katerikoli z OpenAI združljiv `chat/completions` Endpoint. Endpoint in modele izpolnite sami ali uporabite Fetch Models, če to ponudnik podpira."
            }
          },
          "sr-Cyrl": {
            "stringUnit": {
              "state": "translated",
              "value": "Користите било који OpenAI-компатибилан `chat/completions` Endpoint. Endpoint и моделе унесите ручно или употребите Fetch Models ако provider то подржава."
            }
          },
          "sv": {
            "stringUnit": {
              "state": "translated",
              "value": "Använd valfri OpenAI-kompatibel `chat/completions` Endpoint. Fyll i Endpoint och modeller själv, eller använd Fetch Models om leverantören stöder det."
            }
          },
          "ta": {
            "stringUnit": {
              "state": "translated",
              "value": "எந்த OpenAI-compatible `chat/completions` Endpoint-யையும் பயன்படுத்தலாம். Endpoint மற்றும் model-களை நீங்களே நிரப்புங்கள், அல்லது provider ஆதரித்தால் Fetch Models பயன்படுத்துங்கள்."
            }
          },
          "te": {
            "stringUnit": {
              "state": "translated",
              "value": "ఏదైనా OpenAI-compatible `chat/completions` Endpoint‌ను ఉపయోగించండి. Endpoint మరియు models‌ను మీరు స్వయంగా పూరించండి, లేదా provider మద్దతు ఇస్తే Fetch Models ఉపయోగించండి."
            }
          },
          "th": {
            "stringUnit": {
              "state": "translated",
              "value": "ใช้ Endpoint `chat/completions` ใดก็ได้ที่เข้ากันได้กับ OpenAI กรอก Endpoint และโมเดลด้วยตัวเอง หรือใช้ Fetch Models หากผู้ให้บริการรองรับ"
            }
          },
          "tr": {
            "stringUnit": {
              "state": "translated",
              "value": "OpenAI uyumlu herhangi bir `chat/completions` Endpoint kullanın. Endpoint ve modelleri kendiniz doldurun veya sağlayıcı destekliyorsa Fetch Models kullanın."
            }
          },
          "ug": {
            "stringUnit": {
              "state": "translated",
              "value": "ھەر قانداق OpenAI ماس كېلىدىغان `chat/completions` Endpoint نى ئىشلىتىڭ. Endpoint ۋە مودېللەرنى ئۆزىڭىز تولدۇرۇڭ ياكى provider قوللىسا Fetch Models نى ئىشلىتىڭ."
            }
          },
          "uk": {
            "stringUnit": {
              "state": "translated",
              "value": "Використовуйте будь-який сумісний з OpenAI Endpoint `chat/completions`. Заповніть Endpoint і моделі вручну або використайте Fetch Models, якщо провайдер це підтримує."
            }
          },
          "ur": {
            "stringUnit": {
              "state": "translated",
              "value": "کسی بھی OpenAI-compatible `chat/completions` Endpoint کو استعمال کریں۔ Endpoint اور models خود بھریں، یا اگر provider سپورٹ کرتا ہو تو Fetch Models استعمال کریں۔"
            }
          },
          "vi": {
            "stringUnit": {
              "state": "translated",
              "value": "Sử dụng bất kỳ Endpoint `chat/completions` nào tương thích với OpenAI. Tự điền Endpoint và các model, hoặc dùng Fetch Models nếu nhà cung cấp hỗ trợ."
            }
          },
          "zh-Hans": {
            "stringUnit": {
              "state": "translated",
              "value": "使用任意 OpenAI 兼容的 `chat/completions` 地址。Endpoint 和模型需要你自己填写，或在对方支持时通过 Fetch Models 拉取。"
            }
          },
          "zh-Hant": {
            "stringUnit": {
              "state": "translated",
              "value": "使用任意 OpenAI 相容的 `chat/completions` 位址。Endpoint 與模型需要你自行填寫，或在對方支援時透過 Fetch Models 擷取。"
            }
          }
        }
      },
