    "refuse_hide_menu_bar_icon_msg" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now Detected that there is not set input translation shortcut key or selection translation shortcut key!\n\nSet the shortcut key to make sure you can go Easydict and hide the menu bar icon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Se detectó que no hay configurada tecla de atajo para traducción de entrada o traducción de selección!\n\nConfigura la tecla de atajo para asegurarte de poder acceder a Easydict y ocultar el icono de la barra de menú."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力翻訳ショートカットまたは選択翻訳ショートカットが設定されていません！\n\nメニューバーアイコンを非表示にしてもEasydictを開けるよう、ショートカットを設定してください。"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz bolo zistené, že nie je nastavená žiadna klávesová skratka pre preklad vstupu alebo preklad výberu!\n\nNastav klávesovú skratku, aby si mohol používať Easydict a skryť ikonu v lište."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到当前未设置输入翻译快捷键或划词翻译快捷键！\n\n请先设置快捷键确保可以触发 Easydict 再隐藏菜单栏图标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在偵測到未設定輸入翻譯快速鍵或選取翻譯快速鍵！\n\n請設定快速鍵以確保您可以前往 Easydict 並隱藏選單列圖示。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не настроено сочетание клавиш для перевода введённого или выделенного текста!\n\nЗадайте сочетание, чтобы сохранить доступ к Easydict после скрытия значка в строке меню."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не налаштовано сполучення клавіш для перекладу введеного або виділеного тексту!\n\nЗадайте сполучення, щоб зберегти доступ до Easydict після приховування значка у смузі меню."
