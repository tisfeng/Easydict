      "grammar.analysis.credential_source.openai_key.footnote": {
        "extractionState": "stale",
        "localizations": {
          "ar": {
            "stringUnit": {
              "state": "translated",
              "value": "أدخل مفتاح OpenAI API الخاص بك. يدعم Endpoint العنوان الرسمي الموصى به، وما زال بإمكانك تعديله يدويًا."
            }
          },
          "bg": {
            "stringUnit": {
              "state": "translated",
              "value": "Въведете свой собствен OpenAI API ключ. Endpoint поддържа препоръчания официален адрес и все още може да се редактира ръчно."
            }
          },
          "bn": {
            "stringUnit": {
              "state": "translated",
              "value": "আপনার নিজস্ব OpenAI API key দিন। Endpoint-এ প্রস্তাবিত অফিসিয়াল ঠিকানা ব্যবহার করা যায়, তবে আপনি চাইলে হাতে বদলাতেও পারবেন।"
            }
          },
          "ca": {
            "stringUnit": {
              "state": "translated",
              "value": "Introdueix la teva pròpia clau API d’OpenAI. L’endpoint admet l’adreça oficial recomanada i encara es pot editar manualment."
            }
          },
          "cs": {
            "stringUnit": {
              "state": "translated",
              "value": "Vyplňte svůj vlastní OpenAI API klíč. Endpoint podporuje doporučenou oficiální adresu a stále ho můžete ručně upravit."
            }
          },
          "da": {
            "stringUnit": {
              "state": "translated",
              "value": "Indtast din egen OpenAI API-nøgle. Endpoint understøtter den anbefalede officielle adresse og kan stadig redigeres manuelt."
            }
          },
          "de": {
            "stringUnit": {
              "state": "translated",
              "value": "Geben Sie Ihren eigenen OpenAI-API-Schlüssel ein. Der Endpoint unterstützt die empfohlene offizielle Adresse und kann weiterhin manuell bearbeitet werden."
            }
          },
          "el": {
            "stringUnit": {
              "state": "translated",
              "value": "Συμπληρώστε το δικό σας κλειδί OpenAI API. Το Endpoint υποστηρίζει τη συνιστώμενη επίσημη διεύθυνση και μπορεί ακόμη να τροποποιηθεί χειροκίνητα."
            }
          },
          "en": {
            "stringUnit": {
              "state": "translated",
              "value": "Fill in your own OpenAI API key. The endpoint supports the recommended official address and can still be edited manually."
            }
          },
          "es": {
            "stringUnit": {
              "state": "translated",
              "value": "Solo tienes que rellenar tu propia clave de OpenAI. El endpoint admite la dirección oficial recomendada y aún puedes editarlo manualmente."
            }
          },
          "et": {
            "stringUnit": {
              "state": "translated",
              "value": "Sisestage oma OpenAI API võti. Endpoint toetab soovitatud ametlikku aadressi ja seda saab endiselt käsitsi muuta."
            }
          },
          "fa": {
            "stringUnit": {
              "state": "translated",
              "value": "کلید API اوپن‌اِی‌آی خود را وارد کنید. Endpoint از نشانی رسمیِ پیشنهادی پشتیبانی می‌کند و همچنان می‌توانید آن را دستی ویرایش کنید."
            }
          },
          "fi": {
            "stringUnit": {
              "state": "translated",
              "value": "Täytä oma OpenAI API -avaimesi. Endpoint tukee suositeltua virallista osoitetta ja sitä voi silti muokata käsin."
            }
          },
          "fil": {
            "stringUnit": {
              "state": "translated",
              "value": "Ilagay ang sarili mong OpenAI API key. Sinusuportahan ng Endpoint ang inirerekomendang opisyal na address at maaari mo pa rin itong manu-manong baguhin."
            }
          },
          "fr": {
            "stringUnit": {
              "state": "translated",
              "value": "Renseignez votre propre clé API OpenAI. L’endpoint prend en charge l’adresse officielle recommandée et peut toujours être modifié manuellement."
            }
          },
          "he": {
            "stringUnit": {
              "state": "translated",
              "value": "מלא את מפתח ה-API האישי שלך של OpenAI. ה-Endpoint תומך בכתובת הרשמית המומלצת ועדיין ניתן לערוך אותו ידנית."
            }
          },
          "hi": {
            "stringUnit": {
              "state": "translated",
              "value": "अपना OpenAI API key भरें। Endpoint अनुशंसित आधिकारिक पते का समर्थन करता है, और आप इसे अभी भी हाथ से बदल सकते हैं।"
            }
          },
          "hr": {
            "stringUnit": {
              "state": "translated",
              "value": "Unesite vlastiti OpenAI API ključ. Endpoint podržava preporučenu službenu adresu i još ga uvijek možete ručno urediti."
            }
          },
          "hu": {
            "stringUnit": {
              "state": "translated",
              "value": "Adja meg saját OpenAI API-kulcsát. Az Endpoint támogatja az ajánlott hivatalos címet, és továbbra is kézzel szerkeszthető."
            }
          },
          "id": {
            "stringUnit": {
              "state": "translated",
              "value": "Isi OpenAI API key milik Anda sendiri. Endpoint mendukung alamat resmi yang direkomendasikan dan tetap bisa diedit secara manual."
            }
          },
          "it": {
            "stringUnit": {
              "state": "translated",
              "value": "Inserisci la tua chiave API OpenAI. L’endpoint supporta l’indirizzo ufficiale consigliato e può ancora essere modificato manualmente."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "独自の OpenAI API キーを入力してください。エンドポイントには推奨の公式アドレスを使えますが、手動で編集することもできます。"
            }
          },
          "ka": {
            "stringUnit": {
              "state": "translated",
              "value": "შეიყვანეთ თქვენი OpenAI API key. Endpoint მხარს უჭერს რეკომენდებულ ოფიციალურ მისამართს და მისი ხელით შეცვლაც კვლავ შესაძლებელია."
            }
          },
          "km": {
            "stringUnit": {
              "state": "translated",
              "value": "បំពេញ OpenAI API key ផ្ទាល់ខ្លួនរបស់អ្នក។ Endpoint គាំទ្រអាសយដ្ឋានផ្លូវការដែលបានណែនាំ ហើយអ្នកនៅតែអាចកែដោយដៃបាន។"
            }
          },
          "ko": {
            "stringUnit": {
              "state": "translated",
              "value": "자신의 OpenAI API Key를 입력하세요. Endpoint는 권장 공식 주소를 지원하며, 필요하면 수동으로 수정할 수도 있습니다."
            }
          },
          "lo": {
            "stringUnit": {
              "state": "translated",
              "value": "ກອກ OpenAI API key ຂອງທ່ານເອງ. Endpoint ຮອງຮັບທີ່ຢູ່ທາງການທີ່ແນະນຳ ແລະທ່ານຍັງສາມາດແກ້ໄຂດ້ວຍມືໄດ້."
            }
          },
          "lt": {
            "stringUnit": {
              "state": "translated",
              "value": "Įveskite savo OpenAI API raktą. Endpoint palaiko rekomenduojamą oficialų adresą ir vis dar gali būti redaguojamas rankiniu būdu."
            }
          },
          "lv": {
            "stringUnit": {
              "state": "translated",
              "value": "Ievadiet savu OpenAI API atslēgu. Endpoint atbalsta ieteikto oficiālo adresi un to joprojām var rediģēt manuāli."
            }
          },
          "mn-Mong": {
            "stringUnit": {
              "state": "translated",
              "value": "Өөрийн OpenAI API түлхүүрээ оруулна уу. Endpoint нь санал болгосон албан ёсны хаягийг дэмждэг бөгөөд та үүнийг гараар засварлаж болно."
            }
          },
          "ms": {
            "stringUnit": {
              "state": "translated",
              "value": "Isi OpenAI API key anda sendiri. Endpoint menyokong alamat rasmi yang disyorkan dan masih boleh diedit secara manual."
            }
          },
          "my": {
            "stringUnit": {
              "state": "translated",
              "value": "သင်၏ OpenAI API key ကို ဖြည့်ပါ။ Endpoint သည် အကြံပြုထားသော တရားဝင်လိပ်စာကို ပံ့ပိုးပေးပြီး လက်ဖြင့်လည်း ပြင်ဆင်နိုင်ပါသေးသည်။"
            }
          },
          "nb": {
            "stringUnit": {
              "state": "translated",
              "value": "Fyll inn din egen OpenAI API-nøkkel. Endpoint støtter den anbefalte offisielle adressen og kan fortsatt redigeres manuelt."
            }
          },
          "nl": {
            "stringUnit": {
              "state": "translated",
              "value": "Vul je eigen OpenAI API-sleutel in. De Endpoint ondersteunt het aanbevolen officiële adres en kan nog steeds handmatig worden aangepast."
            }
          },
          "pl": {
            "stringUnit": {
              "state": "translated",
              "value": "Wpisz własny klucz OpenAI API. Endpoint obsługuje zalecany oficjalny adres i nadal można go edytować ręcznie."
            }
          },
          "pt": {
            "stringUnit": {
              "state": "translated",
              "value": "Preencha a sua própria chave da API OpenAI. O Endpoint suporta o endereço oficial recomendado e ainda pode ser editado manualmente."
            }
          },
          "pt-BR": {
            "stringUnit": {
              "state": "translated",
              "value": "Preencha sua própria chave da API OpenAI. O Endpoint suporta o endereço oficial recomendado e ainda pode ser editado manualmente."
            }
          },
          "ro": {
            "stringUnit": {
              "state": "translated",
              "value": "Introduce cheia ta OpenAI API. Endpoint acceptă adresa oficială recomandată și poate fi editat manual în continuare."
            }
          },
          "ru": {
            "stringUnit": {
              "state": "translated",
              "value": "Введите свой OpenAI API key. Endpoint поддерживает рекомендуемый официальный адрес, и его по-прежнему можно изменить вручную."
            }
          },
          "sk": {
            "stringUnit": {
              "state": "translated",
              "value": "Vyplňte vlastný OpenAI API kľúč. Endpoint podporuje odporúčanú oficiálnu adresu a stále ho môžete ručne upraviť."
            }
          },
          "sl": {
            "stringUnit": {
              "state": "translated",
              "value": "Vnesite svoj OpenAI API ključ. Endpoint podpira priporočeni uradni naslov in ga je še vedno mogoče ročno urediti."
            }
          },
          "sr-Cyrl": {
            "stringUnit": {
              "state": "translated",
              "value": "Унесите свој OpenAI API кључ. Endpoint подржава препоручену званичну адресу и и даље се може ручно уредити."
            }
          },
          "sv": {
            "stringUnit": {
              "state": "translated",
              "value": "Fyll i din egen OpenAI API-nyckel. Endpoint stöder den rekommenderade officiella adressen och kan fortfarande redigeras manuellt."
            }
          },
          "ta": {
            "stringUnit": {
              "state": "translated",
              "value": "உங்கள் சொந்த OpenAI API Key-ஐ நிரப்புங்கள். Endpoint பரிந்துரைக்கப்பட்ட அதிகாரப்பூர்வ முகவரியை ஆதரிக்கிறது; வேண்டுமெனில் அதை கைமுறையாக மாற்றலாம்."
            }
          },
          "te": {
            "stringUnit": {
              "state": "translated",
              "value": "మీ స్వంత OpenAI API Key‌ను పూరించండి. Endpoint సిఫార్సు చేసిన అధికారిక చిరునామాను మద్దతు ఇస్తుంది, అవసరమైతే మీరు దాన్ని చేతితో మార్చవచ్చు."
            }
          },
          "th": {
            "stringUnit": {
              "state": "translated",
              "value": "กรอก OpenAI API Key ของคุณเองได้เลย Endpoint รองรับที่อยู่ทางการที่แนะนำ และคุณยังแก้ไขเองได้เช่นกัน"
            }
          },
          "tr": {
            "stringUnit": {
              "state": "translated",
              "value": "Kendi OpenAI API anahtarınızı girin. Endpoint önerilen resmî adresi destekler ve hâlâ elle düzenlenebilir."
            }
          },
          "ug": {
            "stringUnit": {
              "state": "translated",
              "value": "ئۆزىڭىزنىڭ OpenAI API key نى تولدۇرۇڭ. Endpoint تەۋسىيە قىلىنغان رەسمىي ئادرېسنى قوللايدۇ، يەنىلا قولدا ئۆزگەرتەلەيسىز."
            }
          },
          "uk": {
            "stringUnit": {
              "state": "translated",
              "value": "Введіть власний OpenAI API key. Endpoint підтримує рекомендовану офіційну адресу, і його все ще можна редагувати вручну."
            }
          },
          "ur": {
            "stringUnit": {
              "state": "translated",
              "value": "اپنی OpenAI API key درج کریں۔ Endpoint تجویز کردہ سرکاری پتے کو سپورٹ کرتا ہے، اور آپ اسے اب بھی دستی طور پر تبدیل کر سکتے ہیں۔"
            }
          },
          "vi": {
            "stringUnit": {
              "state": "translated",
              "value": "Hãy điền OpenAI API key của riêng bạn. Endpoint hỗ trợ địa chỉ chính thức được đề xuất và bạn vẫn có thể chỉnh sửa thủ công."
            }
          },
          "zh-Hans": {
            "stringUnit": {
              "state": "translated",
              "value": "填写你自己的 OpenAI Key 即可。Endpoint 支持使用推荐的官方地址，你也仍然可以手动修改。"
            }
          },
          "zh-Hant": {
            "stringUnit": {
              "state": "translated",
              "value": "填寫你自己的 OpenAI Key 即可。Endpoint 支援使用推薦的官方位址，你也仍可手動修改。"
            }
          }
        }
      },
