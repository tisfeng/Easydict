{
  "env": {
    "VERSION": "",
    "CHANNEL": "beta",
    "BUILD_NUMBER": "",
    "NOTES_FILE": "",
    "DRAFT_MODE": "normal"
  },
  "before_all": "printf '[%s] [INFO] [workflow] Starting Easydict %s (%s) workflow\\n' \"$(date '+%Y-%m-%d %H:%M:%S')\" \"$VERSION\" \"$CHANNEL\" >&2",
  "after_all": "printf '[%s] [INFO] [workflow] Easydict %s workflow completed\\n' \"$(date '+%Y-%m-%d %H:%M:%S')\" \"$VERSION\" >&2",
  "error": "printf '[%s] [ERROR] [workflow] Release failed. Resume with the run ID printed by asc.\\n' \"$(date '+%Y-%m-%d %H:%M:%S')\" >&2",
  "workflows": {
    "prepare": {
      "description": "Prepare and verify local release artifacts",
      "steps": [
        {
          "workflow": "prepare_steps"
        }
      ]
    },
    "draft": {
      "description": "Prepare a release and create a GitHub draft",
      "steps": [
        {
          "workflow": "prepare_steps"
        },
        {
          "workflow": "draft_steps"
        }
      ]
    },
    "publish": {
      "description": "Publish an existing draft and update the appcast",
      "steps": [
        {
          "workflow": "publish_steps"
        }
      ]
    },
    "release": {
      "description": "Run the complete Easydict release workflow",
      "steps": [
        {
          "workflow": "prepare_steps"
        },
        {
          "workflow": "draft_steps"
        },
        {
          "workflow": "publish_steps"
        }
      ]
    },
    "prepare_steps": {
      "private": true,
      "description": "Synchronize branches and prepare local artifacts",
      "steps": [
        {
          "name": "preflight_environment",
          "run": "./scripts/release/release-preflight.sh environment"
        },
        {
          "name": "snapshot_draft_replacement",
          "run": "./scripts/release/release-redraft.sh snapshot"
        },
        {
          "name": "archive_replaced_local_state",
          "run": "if [ \"$DRAFT_MODE\" = replace ]; then ./scripts/release/release-redraft-git.sh archive; else printf '[%s] [INFO] [archive_replaced_local_state] ordinary Draft; no local replacement archive required\\n' \"$(date '+%Y-%m-%d %H:%M:%S')\" >&2; fi"
        },
        {
          "name": "sync_local_dev",
          "run": "./scripts/release/release-branch-sync.sh sync-dev"
        },
        {
          "name": "prepare_release_worktree",
          "run": "./scripts/release/release-branch-sync.sh prepare"
        },
        {
          "name": "preflight_release",
          "run": "./scripts/release/release-preflight.sh release"
        },
        {
          "name": "update_version",
          "run": "./scripts/release/release-build.sh version"
        },
        {
          "name": "archive_application",
          "run": "./scripts/release/release-build.sh archive"
        },
        {
          "name": "export_application",
          "run": "./scripts/release/release-build.sh export"
        },
        {
          "name": "notarize_application",
          "run": "./scripts/release/release-package.sh notarize-app"
        },
        {
          "name": "create_sparkle_zip",
          "run": "./scripts/release/release-package.sh zip"
        },
        {
          "name": "create_notarized_dmg",
          "run": "./scripts/release/release-package.sh dmg"
        },
        {
          "name": "generate_appcast_candidate",
          "run": "./scripts/release/release-appcast.sh generate"
        },
        {
          "name": "verify_local_release",
          "run": "./scripts/release/release-verify.sh local"
        }
      ]
    },
    "draft_steps": {
      "private": true,
      "description": "Publish the temporary release branch and create a GitHub draft",
      "steps": [
        {
          "name": "revalidate_draft_replacement",
          "run": "./scripts/release/release-redraft.sh revalidate"
        },
        {
          "name": "push_draft_refs",
          "run": "./scripts/release/release-branch-sync.sh push-version"
        },
        {
          "name": "delete_replaced_github_draft",
          "run": "./scripts/release/release-redraft.sh delete-draft"
        },
        {
          "name": "create_github_draft",
          "run": "./scripts/release/release-github.sh draft"
        },
        {
          "name": "verify_github_draft",
          "run": "./scripts/release/release-github.sh verify-draft"
        },
        {
          "name": "cleanup_draft_replacement",
          "run": "if [ \"$DRAFT_MODE\" = replace ]; then ./scripts/release/release-redraft-git.sh cleanup; else printf '[%s] [INFO] [cleanup_draft_replacement] ordinary Draft; no replacement backup to clean\\n' \"$(date '+%Y-%m-%d %H:%M:%S')\" >&2; fi"
        }
      ]
    },
    "publish_steps": {
      "private": true,
      "description": "Publish the GitHub release and merge it into dev",
      "steps": [
        {
          "name": "prepare_channel_transition",
          "run": "./scripts/release/release-appcast.sh prepare-publish"
        },
        {
          "name": "preflight_publish",
          "run": "./scripts/release/release-preflight.sh publish"
        },
        {
          "name": "prepare_publish_git",
          "run": "./scripts/release/release-publish-git.sh prepare"
        },
        {
          "name": "publish_github_release",
          "run": "./scripts/release/release-github.sh publish"
        },
        {
          "name": "verify_github_release",
          "run": "./scripts/release/release-github.sh verify-published"
        },
        {
          "name": "install_appcast",
          "run": "./scripts/release/release-appcast.sh install"
        },
        {
          "name": "push_published_refs",
          "run": "./scripts/release/release-publish-git.sh push"
        },
        {
          "name": "promote_previous_github_release",
          "run": "./scripts/release/release-github.sh promote-previous"
        },
        {
          "name": "verify_remote_release",
          "run": "./scripts/release/release-verify.sh remote"
        },
        {
          "name": "cleanup_remote_release_branch",
          "run": "./scripts/release/release-publish-git.sh cleanup"
        },
        {
          "name": "cleanup_release_worktree",
          "run": "./scripts/release/release-branch-sync.sh cleanup"
        }
      ]
    }
  }
}
